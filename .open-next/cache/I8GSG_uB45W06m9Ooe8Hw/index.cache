"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/00e5z2kcxt3i9.js\" async=\"\"></script><script src=\"/_next/static/chunks/14-n6u_790ww-.js\" async=\"\"></script><script src=\"/_next/static/chunks/0zjc6v-lph55z.js\" async=\"\"></script><link rel=\"preload\" href=\"/assets/baytlogic-logo-cyan.png\" as=\"image\"/><link rel=\"preload\" as=\"image\" href=\"/assets/projects/ip-camera-installation-01.jpg\"/><link rel=\"preload\" href=\"/assets/new_projects/sbn_street_cctv.jpeg\" as=\"image\"/><link rel=\"preload\" href=\"/assets/new_projects/ezviz_shakatafi_intercom.jpeg\" as=\"image\"/><link rel=\"preload\" href=\"/assets/new_projects/server_rack_cabling.jpeg\" as=\"image\"/><title>BaytLogic Technologies | Where Intelligence Meets Security</title><meta name=\"description\" content=\"Nigeria&#x27;s leading integrator of intelligent surveillance, cybersecurity, smart home automation, and networking.\"/><link rel=\"icon\" href=\"/icon.svg?icon.2slaykoi5j4ks.svg\" sizes=\"any\" type=\"image/svg+xml\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col selection:bg-cyan-500/30 selection:text-cyan-300 font-sans\"><div class=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none z-0\"></div><div class=\"absolute top-1/3 right-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[160px] pointer-events-none z-0\"></div><div class=\"absolute top-2/3 left-1/3 w-[500px] h-[500px] bg-purple-600/5 rounded-full blur-[140px] pointer-events-none z-0\"></div><header class=\"sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-900/85 backdrop-blur-xl transition-all duration-300\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\"><a href=\"#\" class=\"flex items-center gap-3 group\"><img src=\"/assets/baytlogic-icon-cyan.png\" alt=\"BaytLogic Logo\" class=\"w-10 h-10 object-contain drop-shadow-[0_0_12px_rgba(34,211,238,0.4)] transition-transform duration-300 group-hover:scale-105\"/><div class=\"flex flex-col\"><span class=\"font-extrabold text-white text-xl tracking-wider\">BAYTLOGIC</span><div class=\"flex items-center gap-1.5 -mt-0.5\"><span class=\"text-[10px] text-cyan-400 tracking-widest uppercase font-bold font-mono\">TECHNOLOGIES</span><span class=\"inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-medium bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 font-mono\">Nationwide Service</span></div></div></a><nav class=\"hidden md:flex items-center gap-6 text-sm font-medium\"><a href=\"#\" class=\"text-slate-300 hover:text-cyan-400 transition-colors\">Home</a><a href=\"#services\" class=\"text-slate-300 hover:text-cyan-400 transition-colors\">Solutions</a><a href=\"#projects\" class=\"text-slate-300 hover:text-cyan-400 transition-colors\">Portfolio</a><a href=\"#training\" class=\"text-cyan-400 hover:text-cyan-300 transition-colors font-semibold\">Academy</a><a href=\"#alumni-showcase\" class=\"text-slate-300 hover:text-cyan-400 transition-colors\">Alumni Videos</a><a href=\"/boq\" class=\"text-slate-300 hover:text-cyan-400 transition-colors font-mono text-xs font-semibold px-2 py-1 rounded bg-slate-800/80 border border-slate-700\">BOQ Estimator</a><a href=\"/verify\" class=\"text-slate-300 hover:text-amber-300 transition-colors flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check w-3.5 h-3.5 text-amber-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg> Verify Cert</a><a href=\"/dashboard/login\" class=\"px-3.5 py-1.5 bg-slate-800/90 hover:bg-slate-700 text-cyan-300 border border-slate-700 text-xs font-bold rounded-full transition flex items-center gap-1.5 shadow-md\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock w-3.5 h-3.5 text-cyan-400\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg> Staff Portal</a><a href=\"#contact\" class=\"px-5 py-2 bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold rounded-full transition-all duration-300 shadow-lg shadow-cyan-500/20 transform hover:-translate-y-0.5\">Get a Quote</a></nav></div></header><header class=\"relative pt-24 pb-20 lg:pt-32 lg:pb-28 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center overflow-hidden min-h-[80vh] flex flex-col justify-center items-center\"><canvas class=\"absolute inset-0 w-full h-full pointer-events-none z-0 opacity-40\"></canvas><div class=\"relative z-10 space-y-6\"><div class=\"inline-block px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-900/30 text-cyan-300 text-sm font-semibold backdrop-blur-sm shadow-md\">🛡️ Engineering-Grade Security Solutions</div><h1 class=\"text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight max-w-4xl mx-auto\">Advanced Surveillance &amp; <br/> <span class=\"text-cyan-400 drop-shadow-[0_0_20px_rgba(34,211,238,0.3)]\">Embedded AI Systems</span></h1><p class=\"mt-4 max-w-2xl mx-auto text-lg sm:text-xl text-slate-300 leading-relaxed font-normal\">We don&#x27;t just install cameras; we engineer safety and empower education. From advanced surveillance to school LMS deployments across Nigeria, we build what matters most.</p><div class=\"flex flex-col sm:flex-row justify-center gap-4 pt-6\"><a href=\"#contact\" class=\"px-8 py-4 bg-cyan-500 text-slate-950 font-bold rounded-xl shadow-lg shadow-cyan-500/20 hover:bg-cyan-400 transition duration-300 flex items-center justify-center gap-2 group transform hover:scale-105 active:scale-95\">Request Consultation <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-5 h-5 group-hover:translate-x-1 transition-transform\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a href=\"/docs/BaytLogic_Technologies_Corporate_Profile_V2.pdf\" target=\"_blank\" rel=\"noreferrer\" class=\"px-8 py-4 bg-slate-900/80 border border-slate-700 text-white font-bold rounded-xl hover:border-cyan-400 hover:text-cyan-400 transition-all duration-300 flex items-center justify-center shadow-md\">Download Company Profile</a></div><div class=\"pt-8 flex flex-wrap items-center justify-center gap-6 text-slate-400 text-sm font-medium\"><span class=\"flex items-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 mr-2 text-emerald-400\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Engineering-led deployments</span><span class=\"flex items-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 mr-2 text-emerald-400\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> Nationwide logistics</span></div></div></header><section id=\"services\" class=\"py-20 bg-slate-900/60 border-t border-slate-800/80 relative\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><h2 class=\"text-cyan-400 font-semibold tracking-wide uppercase text-xs font-mono\">The BaytLogic Advantage</h2><h3 class=\"mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl\">Why Business Leaders Choose Us</h3><p class=\"mt-4 max-w-2xl text-lg text-slate-400 mx-auto\">Bridging the gap between theoretical AI research and practical field security across Nigeria.</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-slate-900/90 rounded-2xl p-8 border border-slate-800 hover:border-cyan-500/40 transition duration-300 hover:-translate-y-1.5 group shadow-xl\"><div class=\"bg-slate-800 w-16 h-16 rounded-xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition group-hover:bg-cyan-500 group-hover:text-slate-950 text-cyan-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-8 w-8 transition\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Expert Led Engineering</h3><p class=\"text-slate-300 text-sm leading-relaxed\">Projects delivered by an engineering-led team with strong <strong class=\"text-cyan-300\">Embedded AI</strong> and field deployment experience. We understand the code behind the camera.</p></div><div class=\"bg-slate-900/90 rounded-2xl p-8 border border-slate-800 hover:border-cyan-500/40 transition duration-300 hover:-translate-y-1.5 group shadow-xl\"><div class=\"bg-slate-800 w-16 h-16 rounded-xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition group-hover:bg-cyan-500 group-hover:text-slate-950 text-cyan-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-8 w-8 transition\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Remote &amp; Cloud Viewing</h3><p class=\"text-slate-300 text-sm leading-relaxed\">Whether you are in Lagos, London, or Dubai, monitor your assets in real-time via secure cloud applications.</p></div><div class=\"bg-slate-900/90 rounded-2xl p-8 border border-slate-800 hover:border-cyan-500/40 transition duration-300 hover:-translate-y-1.5 group shadow-xl\"><div class=\"bg-slate-800 w-16 h-16 rounded-xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition group-hover:bg-cyan-500 group-hover:text-slate-950 text-cyan-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap h-8 w-8 transition\" aria-hidden=\"true\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"></path></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Optimized for Nigeria</h3><p class=\"text-slate-300 text-sm leading-relaxed\">Our systems are designed for the Nigerian environment, fully compatible with rugged solar setups and inverter systems.</p></div></div></div></section><section id=\"government\" class=\"py-20 bg-slate-950 border-t border-slate-800/80\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-12\"><h2 class=\"text-cyan-400 font-semibold tracking-wide uppercase text-xs font-mono\">Institutional Capability</h2><h3 class=\"mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl\">Government &amp; Institutional Deployments</h3><p class=\"mt-4 max-w-3xl text-lg text-slate-300 mx-auto\">BaytLogic designs and deploys engineering-grade surveillance and smart infrastructure systems for ministries, schools, hospitals, and public facilities across Nigeria.</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-slate-900/80 rounded-2xl p-8 border border-slate-800 shadow-lg\"><div class=\"bg-cyan-500/10 w-14 h-14 rounded-xl flex items-center justify-center mb-5 text-cyan-400 border border-cyan-500/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check h-7 w-7\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg></div><h4 class=\"text-lg font-bold text-white mb-2\">Structured Delivery</h4><p class=\"text-slate-400 text-sm leading-relaxed\">Site Survey → System Design → Deployment → Commissioning → Training → Maintenance (SLA).</p></div><div class=\"bg-slate-900/80 rounded-2xl p-8 border border-slate-800 shadow-lg\"><div class=\"bg-cyan-500/10 w-14 h-14 rounded-xl flex items-center justify-center mb-5 text-cyan-400 border border-cyan-500/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network h-7 w-7\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg></div><h4 class=\"text-lg font-bold text-white mb-2\">Engineering-Grade Systems</h4><p class=\"text-slate-400 text-sm leading-relaxed\">IP CCTV/NVR, monitoring rooms, access control integration, remote viewing, network hardening, and power backup planning.</p></div><div class=\"bg-slate-900/80 rounded-2xl p-8 border border-slate-800 shadow-lg\"><div class=\"bg-cyan-500/10 w-14 h-14 rounded-xl flex items-center justify-center mb-5 text-cyan-400 border border-cyan-500/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 h-7 w-7\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><h4 class=\"text-lg font-bold text-white mb-2\">Verified Institutional Experience</h4><p class=\"text-slate-400 text-sm leading-relaxed\">CCTV installation completed at <strong class=\"text-cyan-300\">ATBU - Department of Computer &amp; Communications Engineering Laboratory</strong>.</p></div></div><div class=\"mt-10 flex flex-col sm:flex-row gap-4 justify-center\"><a href=\"#contact\" class=\"px-8 py-3.5 bg-cyan-500 text-slate-950 font-bold rounded-xl hover:bg-cyan-400 transition shadow-lg shadow-cyan-500/20 text-center\">Request Institutional Proposal</a><a href=\"/docs/BaytLogic_Technologies_Corporate_Profile_V2.pdf\" target=\"_blank\" rel=\"noreferrer\" class=\"px-8 py-3.5 bg-slate-900 border border-slate-700 text-white font-bold rounded-xl hover:border-cyan-400 hover:text-cyan-400 transition flex items-center justify-center gap-2 shadow-md\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 w-4 h-4 text-cyan-400\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg> View Company Profile</a></div></div></section><div class=\"bg-zinc-950 py-16 border-y border-zinc-900 relative overflow-hidden\"><div class=\"absolute inset-0 opacity-5\" style=\"background-image:linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);background-size:100% 40px\"></div><div class=\"max-w-6xl mx-auto px-6 relative z-10\"><div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 text-center\" style=\"opacity:0\"><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"text-4xl md:text-5xl font-extrabold text-white mb-2 font-mono tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent\"><span>0<!-- -->+</span></div><div class=\"text-cyan-400 text-xs font-semibold tracking-widest uppercase font-mono\">Projects Delivered</div></div><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"text-4xl md:text-5xl font-extrabold text-white mb-2 font-mono tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent\"><span>0<!-- -->%</span></div><div class=\"text-cyan-400 text-xs font-semibold tracking-widest uppercase font-mono\">Uptime Target</div></div><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"text-4xl md:text-5xl font-extrabold text-white mb-2 font-mono tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent\"><span>0<!-- -->+</span></div><div class=\"text-cyan-400 text-xs font-semibold tracking-widest uppercase font-mono\">States Served</div></div><div class=\"flex flex-col items-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"text-4xl md:text-5xl font-extrabold text-white mb-2 font-mono tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent\">24/7</div><div class=\"text-cyan-400 text-xs font-semibold tracking-widest uppercase font-mono\">Support SLA</div></div></div></div></div><section id=\"projects\" class=\"py-20 bg-slate-900/40 border-t border-slate-800/80\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><div class=\"inline-flex items-center justify-center p-2 bg-blue-500/10 rounded-full mb-4 px-4 border border-blue-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video w-4 h-4 text-blue-400 mr-2\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg><span class=\"text-blue-400 text-xs font-bold tracking-widest uppercase font-mono\">PORTFOLIO</span></div><h2 class=\"text-3xl font-extrabold text-white sm:text-4xl\">Featured Installations</h2><p class=\"mt-4 text-lg text-slate-400\">From private residences in Bauchi to institutional facilities.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\"><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/center_for_embedded_ai_atbu.jpeg\" alt=\"ATBU CCE Lab\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> ATBU, Bauchi</div><h3 class=\"text-xl font-bold text-white mb-2\">Center for Embedded AI Laboratory</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Full IP surveillance system installed at ATBU Computer &amp; Communications Engineering Lab.</p></div></div><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/shopping_mall_at_gra.jpeg\" alt=\"Commercial Mall\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> G.R.A, Bauchi</div><h3 class=\"text-xl font-bold text-white mb-2\">GRA Shopping Mall Security</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Structured HD CCTV monitoring for checkout registers and perimeter safety.</p></div></div><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/fadaman_mada_street.jpeg\" alt=\"Street Surveillance\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> Fadaman Mada, Bauchi</div><h3 class=\"text-xl font-bold text-white mb-2\">Fadaman Mada Street Surveillance</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Pole-mounted street coverage providing public security monitoring.</p></div></div><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/sbn_street_cctv.jpeg\" alt=\"SBN Street CCTV\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> SBN Area, Bauchi</div><h3 class=\"text-xl font-bold text-white mb-2\">SBN Street Traffic &amp; Security</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Weatherproof IP cameras with remote mobile app live viewing.</p></div></div><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/ezviz_shakatafi_intercom.jpeg\" alt=\"Commercial Intercom\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> Shakatafi Commercial</div><h3 class=\"text-xl font-bold text-white mb-2\">EZVIZ Smart Intercom Setup</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Smart video intercom and door entry control integrated with mobile unlocking.</p></div></div><div class=\"group relative overflow-hidden rounded-2xl shadow-xl cursor-pointer h-96 border border-slate-800\"><img src=\"/assets/new_projects/server_rack_cabling.jpeg\" alt=\"Server Racks\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-110\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent opacity-90\"></div><div class=\"absolute bottom-0 left-0 p-6 w-full transform translate-y-2 group-hover:translate-y-0 transition duration-300\"><div class=\"flex items-center text-cyan-400 text-xs font-semibold mb-2 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network w-3.5 h-3.5 mr-1\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg> IT Infrastructure</div><h3 class=\"text-xl font-bold text-white mb-2\">Server Room Rack Cabling</h3><p class=\"text-slate-300 text-xs leading-relaxed\">Structured Cat6 cabling, PoE switch patching, and network cabinet installation.</p></div></div></div></div></section><section class=\"py-14 bg-slate-950 border-t border-slate-800/80\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\"><p class=\"text-xs font-semibold text-slate-500 tracking-widest uppercase font-mono mb-8\">Trusted By &amp; Partnered With</p><div class=\"flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-75\"><div class=\"text-lg font-black tracking-widest text-slate-300 font-mono hover:text-white transition duration-300\">NURTURE ROOTS FOUNDATION</div><div class=\"flex items-center gap-3\"><div class=\"flex flex-col text-left pl-3 border-l-2 border-slate-700\"><span class=\"text-xl font-black text-slate-200 tracking-tighter\">NASSCOMSOFT</span><span class=\"text-[10px] font-bold text-cyan-400 tracking-widest uppercase font-mono -mt-1\">EMBEDDED</span></div></div></div></div></section><section id=\"edtech\" class=\"py-20 bg-slate-900/60 border-t border-slate-800/80\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><div class=\"inline-flex items-center justify-center p-2 bg-emerald-500/10 rounded-full mb-4 px-4 border border-emerald-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open w-4 h-4 text-emerald-400 mr-2\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg><span class=\"text-emerald-400 text-xs font-bold tracking-widest uppercase font-mono\">EDTECH &amp; INNOVATION</span></div><h2 class=\"text-3xl font-extrabold text-white sm:text-4xl\">Empowering Education with Technology</h2><p class=\"mt-4 max-w-2xl text-lg text-slate-400 mx-auto\">Transforming learning environments through robust School Management Systems, teacher upskilling, and engaging STEM programs.</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-slate-900 rounded-2xl p-8 border border-slate-800 hover:border-emerald-500/40 transition shadow-lg flex flex-col justify-between group\"><div><div class=\"bg-emerald-500/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 text-emerald-400 border border-emerald-500/20 group-hover:bg-emerald-500 group-hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-laptop h-8 w-8 transition\" aria-hidden=\"true\"><path d=\"M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z\"></path><path d=\"M20.054 15.987H3.946\"></path></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Enterprise LMS &amp; Portals</h3><p class=\"text-slate-300 text-sm leading-relaxed mb-6\">Custom-built Learning Management Systems (LMS) and school portals designed to streamline administration, grading, and student engagement.</p></div><div class=\"pt-4 border-t border-slate-800\"><p class=\"text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-2 font-mono\">Featured Deployment</p><a href=\"https://minaret.sch.ng\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center px-3.5 py-2 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-lg text-xs font-bold hover:bg-emerald-500 hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-3.5 h-3.5 mr-1.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg> Minaret Int&#x27;l School</a></div></div><div class=\"bg-slate-900 rounded-2xl p-8 border border-slate-800 hover:border-blue-500/40 transition shadow-lg group\"><div class=\"bg-blue-500/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 text-blue-400 border border-blue-500/20 group-hover:bg-blue-500 group-hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-8 w-8 transition\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Digital Skills for Educators</h3><p class=\"text-slate-300 text-sm leading-relaxed\">Comprehensive training programs equipping teachers with modern digital tools, software proficiency, and pedagogical strategies needed for 21st-century classrooms.</p></div><div class=\"bg-slate-900 rounded-2xl p-8 border border-slate-800 hover:border-purple-500/40 transition shadow-lg group\"><div class=\"bg-purple-500/10 w-16 h-16 rounded-xl flex items-center justify-center mb-6 text-purple-400 border border-purple-500/20 group-hover:bg-purple-500 group-hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bot h-8 w-8 transition\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"></path><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"></rect><path d=\"M2 14h2\"></path><path d=\"M20 14h2\"></path><path d=\"M15 13v2\"></path><path d=\"M9 13v2\"></path></svg></div><h3 class=\"text-xl font-bold text-white mb-3\">Kids Robotics &amp; STEM</h3><p class=\"text-slate-300 text-sm leading-relaxed\">Interactive bootcamps and school curriculum integration for robotics, coding, and electronics, preparing young minds for the future of technology and AI.</p></div></div></div></section><section id=\"training\" class=\"py-20 bg-slate-950 border-t border-slate-800/80\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center mb-16\"><div class=\"inline-flex items-center justify-center p-2 bg-purple-500/10 rounded-full mb-4 px-4 border border-purple-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap w-4 h-4 text-purple-400 mr-2\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg><span class=\"text-purple-400 text-xs font-bold tracking-widest uppercase font-mono\">BAYTLOGIC ACADEMY</span></div><h2 class=\"text-3xl font-extrabold text-white sm:text-4xl\">Upcoming Training &amp; Bootcamps</h2><p class=\"mt-4 max-w-2xl text-lg text-slate-400 mx-auto\">Empowering the next generation with practical, hands-on engineering and technology skills.</p></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\"><div class=\"bg-slate-900 rounded-2xl p-8 border border-slate-800 hover:border-cyan-500/40 transition shadow-xl relative overflow-hidden group\"><div class=\"absolute top-0 right-0 bg-red-500 text-white text-[10px] font-bold px-4 py-1.5 rounded-bl-xl font-mono uppercase tracking-wider shadow-sm\">Starts March 28</div><div class=\"flex items-center gap-4 mb-6\"><div class=\"bg-cyan-500/10 p-4 rounded-xl text-cyan-400 border border-cyan-500/20 group-hover:bg-cyan-500 group-hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video w-7 h-7\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg></div><div><h3 class=\"text-2xl font-bold text-white\">Smart Home Automation &amp; CCTV</h3><p class=\"text-cyan-400 font-semibold text-xs tracking-wider uppercase font-mono\">Professional Class</p></div></div><p class=\"text-slate-300 text-sm leading-relaxed mb-8\">Master the installation, configuration, and remote networking of modern IP surveillance systems and smart home integrations in a fully hands-on environment.</p><div class=\"flex flex-wrap items-center gap-4\"><a href=\"https://forms.gle/3o4bD2jJa5Tx9eCLA\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center px-5 py-2.5 bg-cyan-500 text-slate-950 font-bold rounded-lg hover:bg-cyan-400 transition shadow-md\">Register Now <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 ml-2\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a href=\"#verification\" class=\"text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check w-4 h-4 text-emerald-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg> Verify Certificate</a></div></div><div class=\"bg-slate-900 rounded-2xl p-8 border border-slate-800 hover:border-purple-500/40 transition shadow-xl relative overflow-hidden group\"><div class=\"absolute top-0 right-0 bg-gradient-to-r from-purple-600 to-pink-500 text-white text-[10px] font-bold px-4 py-1.5 rounded-bl-xl font-mono uppercase tracking-wider shadow-sm animate-pulse\">April 6 - April 24</div><div class=\"flex items-center gap-4 mb-6\"><div class=\"bg-purple-500/10 p-4 rounded-xl text-purple-400 border border-purple-500/20 group-hover:bg-purple-500 group-hover:text-slate-950 transition\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bot w-7 h-7\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"></path><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"></rect><path d=\"M2 14h2\"></path><path d=\"M20 14h2\"></path><path d=\"M15 13v2\"></path><path d=\"M9 13v2\"></path></svg></div><div><h3 class=\"text-2xl font-bold text-white\">Kids Robotics Bootcamp</h3><p class=\"text-purple-400 font-semibold text-xs tracking-wider uppercase font-mono\">Interactive Learning</p></div></div><p class=\"text-slate-300 text-sm leading-relaxed mb-8\">A hands-on robotics bootcamp running from April 6 to April 24, designed to introduce children to robotics, coding, and electronics in a fun, practical way.</p><a href=\"https://wa.me/2348032476476?text=Hello%20BaytLogic,%20I%20am%20interested%20in%20pre-registering%20my%20child%20for%20the%20Kids%20Robotics%20Bootcamp.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center px-5 py-2.5 border border-purple-500/40 text-purple-400 font-bold rounded-lg hover:bg-purple-500 hover:text-slate-950 transition shadow-md\">Pre-Register <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 ml-2\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section id=\"sponsorship\" class=\"py-20 bg-slate-900/90 text-white border-t border-slate-800/80 relative overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"text-center max-w-4xl mx-auto mb-20\"><div class=\"inline-flex items-center justify-center p-2 bg-cyan-500/10 rounded-full mb-6 px-4 border border-cyan-500/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart-handshake w-4 h-4 text-cyan-400 mr-2\" aria-hidden=\"true\"><path d=\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\"></path></svg><span class=\"text-cyan-400 text-xs font-bold tracking-widest uppercase font-mono\">Institutional Youth Sponsorship</span></div><h2 class=\"text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-6\">Invest in Youth. Build Practical Technology Skills. Create Opportunity.</h2><p class=\"text-lg sm:text-xl text-slate-300 leading-relaxed max-w-3xl mx-auto mb-8\">BaytLogic Technologies provides practical, hands-on technology training designed to help young people develop marketable technical skills, pursue employment opportunities and build technology-based businesses.</p><div class=\"flex flex-wrap justify-center gap-4 mb-8\"><a href=\"https://wa.me/2348032476476?text=Hello%20BaytLogic,%20we%20are%20an%20NGO/Institution%20interested%20in%20sponsoring%20youth%20technology%20training.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"px-8 py-4 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-xl shadow-lg transition transform hover:-translate-y-0.5 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart-handshake w-5 h-5\" aria-hidden=\"true\"><path d=\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\"></path></svg> Sponsor Youth Training</a><a href=\"#sponsorship-impact\" class=\"px-8 py-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl border border-slate-700 transition flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-line w-5 h-5 text-cyan-400\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"m19 9-5 5-4-4-3 3\"></path></svg> View Our Impact</a></div><div class=\"inline-flex flex-wrap items-center justify-center gap-2 sm:gap-4 px-6 py-2.5 bg-slate-800/60 rounded-full border border-slate-700/80 text-xs sm:text-sm text-slate-300 font-medium\"><span>Practical training</span> <span class=\"text-slate-600\">•</span><span>Real devices</span> <span class=\"text-slate-600\">•</span><span>Documented outcomes</span> <span class=\"text-slate-600\">•</span><span>Verifiable certificates</span></div></div><div class=\"mb-24\"><div class=\"text-center mb-12\"><h3 class=\"text-2xl font-bold text-white\">The Five-Step Programme Model</h3><p class=\"text-sm text-slate-400 mt-2\">A structured pathway from institutional sponsorship to tangible post-training outcomes</p></div><div class=\"grid grid-cols-1 md:grid-cols-5 gap-4 relative\"><div class=\"bg-slate-800/60 p-6 rounded-2xl border border-slate-700 hover:border-cyan-500/40 transition\"><div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-extrabold text-sm mb-4 font-mono\">01</div><h4 class=\"text-lg font-bold text-white mb-2\">SPONSOR</h4><p class=\"text-xs text-slate-300 leading-relaxed\">An NGO or institution sponsors selected young people for technical skills training.</p></div><div class=\"bg-slate-800/60 p-6 rounded-2xl border border-slate-700 hover:border-cyan-500/40 transition\"><div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-extrabold text-sm mb-4 font-mono\">02</div><h4 class=\"text-lg font-bold text-white mb-2\">TRAIN</h4><p class=\"text-xs text-slate-300 leading-relaxed\">Participants receive structured practical training delivered by experienced technicians.</p></div><div class=\"bg-slate-800/60 p-6 rounded-2xl border border-slate-700 hover:border-cyan-500/40 transition\"><div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-extrabold text-sm mb-4 font-mono\">03</div><h4 class=\"text-lg font-bold text-white mb-2\">PRACTICE</h4><p class=\"text-xs text-slate-300 leading-relaxed\">Participants work directly with real smart-home, CCTV, networking and automation equipment.</p></div><div class=\"bg-slate-800/60 p-6 rounded-2xl border border-slate-700 hover:border-cyan-500/40 transition\"><div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-extrabold text-sm mb-4 font-mono\">04</div><h4 class=\"text-lg font-bold text-white mb-2\">CERTIFY</h4><p class=\"text-xs text-slate-300 leading-relaxed\">Successful participants receive a BaytLogic certificate with a verifiable certificate ID.</p></div><div class=\"bg-slate-800/60 p-6 rounded-2xl border border-slate-700 hover:border-cyan-500/40 transition\"><div class=\"w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-extrabold text-sm mb-4 font-mono\">05</div><h4 class=\"text-lg font-bold text-white mb-2\">PROGRESS</h4><p class=\"text-xs text-slate-300 leading-relaxed\">BaytLogic tracks available post-training outcomes such as employment &amp; entrepreneurship.</p></div></div></div><div class=\"mb-24\"><div class=\"text-center mb-12\"><h3 class=\"text-2xl font-bold text-white\">What Sponsored Trainees Receive</h3><p class=\"text-sm text-slate-400 mt-2\">Comprehensive hands-on training built around commercial industry standards</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\"><div class=\"bg-slate-800/50 rounded-2xl p-7 border border-slate-700/80\"><div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu w-6 h-6\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg></div><h4 class=\"text-xl font-bold text-white mb-4\">Smart Home Automation</h4><ul class=\"space-y-2.5 text-xs text-slate-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Tuya / Smart Life Ecosystem</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Zigbee Hub &amp; Smart Gateway Setup</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Smart Switch &amp; Relay Wiring</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Door/Window Motion Sensors</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Mobile &amp; Voice Automation Rules</li></ul></div><div class=\"bg-slate-800/50 rounded-2xl p-7 border border-slate-700/80\"><div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video w-6 h-6\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg></div><h4 class=\"text-xl font-bold text-white mb-4\">Professional CCTV Systems</h4><ul class=\"space-y-2.5 text-xs text-slate-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> IP Cameras &amp; NVR Configurations</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> PoE Switches &amp; IP Subnetting</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> RJ45 Cable Termination &amp; Crimping</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Mobile Remote View Setup</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Hardware Brands: EZVIZ, Reolink, Hikvision</li></ul></div><div class=\"bg-slate-800/50 rounded-2xl p-7 border border-slate-700/80\"><div class=\"w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench w-6 h-6\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg></div><h4 class=\"text-xl font-bold text-white mb-4\">Field Practice &amp; Certification</h4><ul class=\"space-y-2.5 text-xs text-slate-300\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Practical Fault Troubleshooting</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Real-World Site Installation Exercises</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Performance Assessment</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Official Certificate of Completion</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check w-4 h-4 text-cyan-400 shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> Online Verifiable Certificate ID</li></ul></div></div></div><div class=\"mb-24 bg-slate-800/40 rounded-3xl p-8 sm:p-10 border border-slate-700/80\"><div class=\"max-w-3xl\"><div class=\"inline-flex items-center gap-2 text-cyan-400 text-xs font-bold uppercase tracking-wider mb-3 font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-4 h-4\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg> Learner Profile</div><h3 class=\"text-2xl sm:text-3xl font-bold text-white mb-4\">Who Our Trainees Are</h3><p class=\"text-sm text-slate-300 leading-relaxed mb-6\">Our training programmes attract serious technology learners committed to gaining real technical skills. Participants come from diverse educational backgrounds:</p><ul class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-200\"><li class=\"flex items-start gap-2 bg-slate-800/80 p-3 rounded-xl border border-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>University graduates seeking job-ready practical engineering skills.</span></li><li class=\"flex items-start gap-2 bg-slate-800/80 p-3 rounded-xl border border-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Postgraduate students deepening applied technical proficiency.</span></li><li class=\"flex items-start gap-2 bg-slate-800/80 p-3 rounded-xl border border-slate-700 border-cyan-500/40\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 text-amber-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><span><strong class=\"text-white\">Four participants are Master&#x27;s students studying Embedded AI.</strong></span></li><li class=\"flex items-start gap-2 bg-slate-800/80 p-3 rounded-xl border border-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Learners passionate about practical IoT, security, and smart automation.</span></li></ul></div></div><div id=\"sponsorship-impact\" class=\"mb-24\"><div class=\"text-center max-w-2xl mx-auto mb-12\"><h3 class=\"text-2xl sm:text-3xl font-extrabold text-white\">From Training to Real-World Outcomes</h3><p class=\"text-sm text-slate-400 mt-2\">Documented examples of alumni progression following practical training cohorts</p></div><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"><div class=\"bg-slate-800/70 rounded-2xl p-8 border border-slate-700 flex flex-col justify-between\"><div><div class=\"inline-block px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-bold mb-4 font-mono\">Internal Employment Outcome</div><h4 class=\"text-2xl font-bold text-white mb-3\">8 Graduates Hired as BaytLogic Technical Staff</h4><p class=\"text-sm text-slate-300 leading-relaxed mb-6\">8 graduates from Cohorts 1 &amp; 2 are now working as staff with BaytLogic Technologies. High-performing graduates progressed into technical roles, creating a direct example of how practical training develops talent.</p></div><div class=\"pt-4 border-t border-slate-700/80 flex items-center justify-between text-xs text-slate-400\"><span>Direct Staff Recruitment</span><span class=\"text-cyan-400 font-semibold\">Cohorts 1 &amp; 2</span></div></div><div class=\"bg-slate-800/70 rounded-2xl p-8 border border-slate-700 flex flex-col justify-between\"><div><div class=\"inline-block px-3 py-1 bg-purple-500/10 text-purple-400 border border-purple-500/30 rounded-full text-xs font-bold mb-4 font-mono\">Entrepreneurship Outcome</div><h4 class=\"text-2xl font-bold text-white mb-3\">Kareem Shaheed - Kwara State</h4><p class=\"text-sm text-slate-300 leading-relaxed mb-6\">Kareem Shaheed is an alumnus who established his own startup in Kwara State, applying practical smart automation and security installation skills gained during training.</p></div><div class=\"pt-4 border-t border-slate-700/80 flex items-center justify-between\"><span class=\"text-xs text-slate-400\">Independent Venture Launch</span><button type=\"button\" class=\"px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-play w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"M9 9.003a1 1 0 0 1 1.517-.859l4.997 2.997a1 1 0 0 1 0 1.718l-4.997 2.997A1 1 0 0 1 9 14.996z\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg> Watch Story</button></div></div></div></div><div class=\"bg-gradient-to-br from-slate-800 to-slate-900 rounded-3xl p-8 sm:p-12 border border-slate-700 mb-20\"><div class=\"max-w-3xl mx-auto text-center mb-10\"><h3 class=\"text-2xl sm:text-3xl font-extrabold text-white\">Sponsorship Model</h3><p class=\"text-sm text-slate-300 mt-2\">Clear, predictable per-trainee structure for institutional budgeting</p><div class=\"mt-4 inline-block px-4 py-1.5 bg-cyan-500/20 text-cyan-300 rounded-full font-extrabold text-sm border border-cyan-500/40 font-mono\">Base Training Fee: ₦30,000 per trainee</div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\"><div class=\"bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center\"><span class=\"text-xs text-slate-400 uppercase font-semibold font-mono\">10 Trainees</span><div class=\"text-2xl font-extrabold text-white my-2 font-mono\">₦300,000</div><p class=\"text-[11px] text-slate-400\">Illustrative sponsorship amount</p></div><div class=\"bg-slate-900/80 p-6 rounded-2xl border border-cyan-500/50 text-center shadow-lg relative\"><div class=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-cyan-500 text-slate-950 text-[10px] font-bold px-3 py-0.5 rounded-full uppercase font-mono\">Popular Cohort</div><span class=\"text-xs text-slate-400 uppercase font-semibold font-mono\">25 Trainees</span><div class=\"text-2xl font-extrabold text-cyan-400 my-2 font-mono\">₦750,000</div><p class=\"text-[11px] text-slate-400\">Illustrative sponsorship amount</p></div><div class=\"bg-slate-900/80 p-6 rounded-2xl border border-slate-700 text-center\"><span class=\"text-xs text-slate-400 uppercase font-semibold font-mono\">50 Trainees</span><div class=\"text-2xl font-extrabold text-white my-2 font-mono\">₦1,500,000</div><p class=\"text-[11px] text-slate-400\">Illustrative sponsorship amount</p></div></div><div class=\"text-center\"><a href=\"https://wa.me/2348032476476?text=Hello%20BaytLogic,%20we%20would%20like%20to%20discuss%20an%20institutional%20sponsorship%20package.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"px-8 py-3.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-xl shadow-lg transition inline-flex items-center gap-2 text-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square w-4 h-4\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path></svg> Discuss Sponsorship</a></div></div><div class=\"bg-slate-800/80 rounded-3xl p-8 sm:p-12 border border-slate-700 text-center max-w-4xl mx-auto\"><h3 class=\"text-2xl sm:text-4xl font-extrabold text-white mb-4\">Help a Young Person Move From Learning to Earning.</h3><p class=\"text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto mb-8\">Partner with BaytLogic Technologies to sponsor practical technology training for young people and help expand access to skills, employment pathways and entrepreneurship opportunities.</p><div class=\"flex flex-wrap justify-center gap-4 text-sm font-bold\"><a href=\"https://wa.me/2348032476476?text=Hello%20BaytLogic,%20I%20want%20to%20sponsor%20youth%20training.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"px-6 py-3.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 rounded-xl shadow-lg transition flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart-handshake w-4 h-4\" aria-hidden=\"true\"><path d=\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\"></path></svg> Sponsor Youth Training</a><a href=\"#contact\" class=\"px-6 py-3.5 bg-slate-700 hover:bg-slate-600 text-white rounded-xl border border-slate-600 transition flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-4 h-4 text-cyan-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg> Talk to BaytLogic</a></div></div></div></section><section id=\"alumni-showcase\" class=\"py-24 relative overflow-hidden bg-slate-950/80 border-t border-slate-800/60\"><div class=\"absolute top-1/2 left-10 w-96 h-96 bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none\"></div><div class=\"absolute bottom-10 right-10 w-96 h-96 bg-purple-600/10 rounded-full blur-[140px] pointer-events-none\"></div><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"text-center max-w-3xl mx-auto mb-14 space-y-4\"><div class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold uppercase tracking-wider font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap w-4 h-4\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg> Trainee Project Showcase</div><h2 class=\"text-3xl sm:text-4xl font-extrabold text-white tracking-tight\">Proven Alumni <span class=\"bg-gradient-to-r from-cyan-400 via-cyan-300 to-purple-400 bg-clip-text text-transparent\">Practical Outcomes</span></h2><p class=\"text-sm sm:text-base text-slate-300\">Documented video demonstrations of working hardware prototypes, smart home setups, and robotics systems built by BaytLogic Academy trainees.</p><div class=\"flex flex-wrap justify-center gap-2 pt-4\"><button class=\"px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/25 scale-105\">All Projects</button><button class=\"px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 bg-slate-900/90 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700\">Kids Robotics &amp; STEM</button><button class=\"px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 bg-slate-900/90 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700\">Smart Home Automation</button><button class=\"px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 bg-slate-900/90 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700\">CCTV &amp; Security</button><button class=\"px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 bg-slate-900/90 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700\">Embedded AI &amp; Edge</button></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"group bg-slate-900/80 border border-slate-800/80 hover:border-cyan-500/50 rounded-2xl overflow-hidden shadow-xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col justify-between\" style=\"opacity:0;transform:scale(0.95)\"><div><div class=\"relative h-48 w-full bg-slate-950 overflow-hidden cursor-pointer\"><img src=\"https://img.youtube.com/vi/mfEC5u1p76s/hqdefault.jpg\" alt=\"Live Smart Home Automation &amp; Wireless Control System\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100\"/><div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent\"></div><div class=\"absolute inset-0 flex items-center justify-center\"><div class=\"w-14 h-14 rounded-full bg-cyan-500/90 group-hover:bg-cyan-400 text-slate-950 flex items-center justify-center shadow-lg shadow-cyan-500/40 transition-transform duration-300 group-hover:scale-110\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play w-6 h-6 fill-slate-950 ml-0.5\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></div></div><div class=\"absolute top-3 left-3\"><span class=\"px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-950/80 text-cyan-300 border border-cyan-500/30 backdrop-blur-md\">Smart Home Automation</span></div><div class=\"absolute bottom-3 right-3 text-[11px] text-slate-400 font-mono\">Masterclass 2026</div></div><div class=\"p-5 space-y-3\"><div class=\"flex items-center gap-2 text-xs font-semibold text-cyan-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-3.5 h-3.5 text-cyan-400\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span>Olopade Fasilat</span></div><h3 class=\"font-bold text-white text-base leading-snug group-hover:text-cyan-300 transition-colors\">Live Smart Home Automation &amp; Wireless Control System</h3><p class=\"text-xs text-slate-400 leading-relaxed line-clamp-3\">Olopade Fasilat presents her practical smart home automation project built at BaytLogic Academy, showcasing live touch relay control and multi-room lighting automation.</p></div></div><div class=\"p-5 pt-0 space-y-3\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 font-mono\">#<!-- -->Smart Home</span><span class=\"text-[10px] px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 font-mono\">#<!-- -->Touch Relay</span><span class=\"text-[10px] px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 font-mono\">#<!-- -->Tuya Automation</span><span class=\"text-[10px] px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 font-mono\">#<!-- -->Lighting</span></div><button class=\"w-full py-2.5 rounded-xl bg-slate-800/80 hover:bg-cyan-500 hover:text-slate-950 text-slate-300 font-bold text-xs transition-all duration-300 flex items-center justify-center gap-2 border border-slate-700 hover:border-cyan-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-video w-3.5 h-3.5\" aria-hidden=\"true\"><path d=\"m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5\"></path><rect x=\"2\" y=\"6\" width=\"14\" height=\"12\" rx=\"2\"></rect></svg> Watch Video Story</button></div></div><div class=\"group bg-slate-900/80 border border-slate-800/80 hover:border-cyan-500/50 rounded-2xl overflow-hidden shadow-xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col justify-between\" style=\"opacity:0;transform:scale(0.95)\"><div><div class=\"relative h-48 w-full bg-slate-950 overflow-hidden cursor-pointer\"><img src=\"https://img.youtube.com/vi/edSKYwBEh5c/hqdefault.jpg\" alt=\"IoT Smart Home &amp; Security Automation Showcase\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100\"/><div class=\"absolute inset-0 bg-gradient-to-t from-sla